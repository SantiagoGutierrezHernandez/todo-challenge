{
    "configurations": [
        {
            "name": "Attach (Remote Django App)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 3002
            },
            "pathMappings": [
                {
                  "localRoot": "${workspaceFolder}/app",
                  "remoteRoot": "/mnt/app"
                }
            ],
            "justMyCode": false,
        }
    ]
}